# =========================================================================
# MusicLink Backend — Environment Variables Template
# =========================================================================
# Salin file ini menjadi .env dan isi nilainya
# cp .env.example .env
# JANGAN push file .env ke GitHub!
# =========================================================================

# ── Server ──
PORT=5000

# ── Database (Supabase PostgreSQL) ──
# Format: postgresql://user:password@host:port/dbname
# Gunakan port 6543 (Supabase pooler) jika mengalami connection error
SUPABASE_DSN=postgresql://postgres.YOURPROJECT:YOURPASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# ── JWT ──
# Gunakan string acak yang panjang dan tidak mudah ditebak!
# Generate: openssl rand -hex 64
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_minimum_32_chars

# ── CORS (Frontend URL) ──
# Untuk multiple origins, pisahkan dengan koma (tanpa spasi):
# FRONTEND_URL=https://musiclink.vercel.app,https://www.musiclink.app
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# ── Swagger Host (untuk deployment) ──
# Isi dengan domain backend Anda setelah deploy
# Contoh: musiclink-api.railway.app
APP_HOST=localhost:5000
